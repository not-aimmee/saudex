{
  "version": "1.0",
  "tools": [
    {
      "name": "freight_inquiry",
      "description": "Handle freight forwarding inquiries",
      "inputSchema": {
        "type": "object",
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "weight": { "type": "number" },
          "dimensions": { "type": "string" }
        },
        "required": ["origin", "destination", "weight"]
      }
    },
    {
      "name": "cargo_tracking",
      "description": "Track shipment status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tracking_id": { "type": "string" }
        },
        "required": ["tracking_id"]
      }
    }
  ]
}